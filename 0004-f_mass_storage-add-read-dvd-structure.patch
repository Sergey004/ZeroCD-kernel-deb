From: ZeroCD DVD support series
Subject: [PATCH 4/6] usb: gadget: f_mass_storage: add READ DVD STRUCTURE command

READ DVD STRUCTURE (opcode 0xAD) is sent by Windows and macOS after
GET CONFIGURATION confirms a DVD-ROM profile. It retrieves the disc's
Physical Format Information (PFI) from the Lead-in area.

Without this command, Windows throws a "disc not recognized" error
even though it already know the profile is DVD-ROM.

Implemented formats:
  0x00 Physical Format Information -- disc geometry, layer count,
       starting/ending PSN for the data zone
  0xFF Copyright Information Request -- returns "no copyright protection"

All other format codes return INVALID FIELD IN CDB per MMC-6.

The Physical Sector Numbers (PSN) follow DVD-ROM Book A spec:
Data zone starts at PSN 0x030000 (196608)
End PSN is derived from num_sectors + start - 1

References: MMC-6 section 6.28 (READ DVD STRUCTURE)

Signed-off-by: ZeroCD patch series
---
 drivers/usb/gadget/function/f_mass_storage.c | 80 +++++++++++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/drivers/usb/gadget/function/f_mass_storage.c b/drivers/usb/gadget/function/f_mass_storage.c
index e5465bfa4b93..6f591c1f8050 100644
--- a/drivers/usb/gadget/function/f_mass_storage.c
+++ b/drivers/usb/gadget/function/f_mass_storage.c
@@ -1297,6 +1297,74 @@ static int do_get_configuration(struct fsg_common *common,
 	return min_t(int, len, alloc_len);
 }
 
+/*
+ * do_read_dvd_structure - MMC-6 section 6.28
+ *
+ * Returns physical disc information for DVD-ROM images.
+ * Called after host receives DVD-ROM profile from GET CONFIGURATION.
+ */
+static int do_read_dvd_structure(struct fsg_common *common,
+		struct fsg_buffhd *bh)
+{
+	struct fsg_lun	*curlun = common->curlun;
+	u8		*buf = (u8 *)bh->buf;
+	u8		format = common->cmnd[7];
+	u32		alloc_len = get_unaligned_be16(&common->cmnd[8]);
+	u32		start_psn;
+	u32		end_psn;
+	int		len;
+
+	if (alloc_len == 0)
+		return 0;
+
+	memset(buf, 0, 2052);
+
+	switch (format) {
+	case 0x00:		/* Physical Format Information */
+		start_psn = 0x030000;
+		end_psn = start_psn + (u32)curlun->num_sectors - 1;
+
+		len = 4 + 20;	/* 4-byte header + 20-byte PFI */
+
+		/* Header: Data Length */
+		put_unaligned_be16(len - 2, buf);
+
+		/* PFI bytes (offset 4) */
+		buf[4] = 0x01;		/* Disc Category=0, Part Version=1 */
+		buf[5] = 0x0F;		/* Disc Size=0 (120mm), Max Rate=0xF */
+		buf[6] = 0x01;		/* Num Layers=0 (1), Track Path=0 (PTP),
+				 * Layer Type=1 (read-only) */
+		buf[7] = 0x01;		/* Linear Density=0, Track Density=0 */
+		buf[8] = 0;
+		buf[9] = (start_psn >> 16) & 0xFF;
+		buf[10] = (start_psn >> 8) & 0xFF;
+		buf[11] = (start_psn) & 0xFF;
+		buf[12] = 0;
+		buf[13] = (end_psn >> 16) & 0xFF;
+		buf[14] = (end_psn >> 8) & 0xFF;
+		buf[15] = (end_psn) & 0xFF;
+		buf[16] = 0;
+		buf[17] = (end_psn >> 16) & 0xFF;
+		buf[18] = (end_psn >> 8) & 0xFF;
+		buf[19] = (end_psn) & 0xFF;
+		buf[20] = 0x00;
+		break;
+
+	case 0xFF:		/* Copyright Information Request */
+		len = 4 + 4;
+		put_unaligned_be16(len - 2, buf);
+		buf[4] = 0;		/* Copyright Protection System Type: none */
+		buf[5] = 0;		/* Region Management Information: none */
+		break;
+
+	default:
+		curlun->sense_data = SS_INVALID_FIELD_IN_CDB;
+		return -EINVAL;
+	}
+
+	return min_t(int, len, alloc_len);
+}
+
 static int do_read_toc(struct fsg_common *common, struct fsg_buffhd *bh)
 {
 	struct fsg_lun	*curlun = common->curlun;
@@ -2096,7 +2164,19 @@ static int do_scsi_command(struct fsg_common *common)
 		reply = do_read_header(common, bh);
 		break;
 
+	case 0xAD:		/* READ DVD STRUCTURE */
+		if (!common->curlun || !common->curlun->cdrom)
+			goto unknown_cmnd;
+		common->data_size_from_cmnd =
+			get_unaligned_be16(&common->cmnd[8]);
+		reply = check_command(common, 12, DATA_DIR_TO_HOST,
+				(0xf<<2) | (1<<8), 1,
+				"READ DVD STRUCTURE");
+		if (reply == 0)
+			reply = do_read_dvd_structure(common, bh);
+		break;
+
 case READ_TOC:
 		if (!common->curlun || !common->curlun->cdrom)
 			goto unknown_cmnd;
 		common->data_size_from_cmnd =
 			get_unaligned_be16(&common->cmnd[7]);
