+/*
+ * do_read_disc_information - MMC-6 section 6.22
+ *
+ * Returns information about disc status. We always report a complete,
+ * non-erasable single-session disc with one track.
+ */
+static int do_read_disc_information(struct fsg_common *common,
+		struct fsg_buffhd *bh)
+{
+	u8 *buf = (u8 *)bh->buf;
+	u8 data_type;
+	u16 alloc_len;
+	int len;
+
+	alloc_len = get_unaligned_be16(&common->cmnd[7]);
+	if (alloc_len == 0)
+		return 0;
+
+	/* Data Block Type: bits 2:0 of byte 1 */
+	data_type = common->cmnd[1] & 0x07;
+
+	if (data_type != 0x00) {
+		/* Only Standard Disc Information (0b000) supported */
+		common->curlun->sense_data = SS_INVALID_FIELD_IN_CDB;
+		return -EINVAL;
+	}
+
+	/* Standard Disc Information block: 34 bytes total */
+	len = 34;
+	memset(buf, 0, len);
+
+	/* Disc Information Length (bytes 0-1): length - 2 */
+	put_unaligned_be16(len - 2, buf);
+
+	/*
+	 * byte 2:
+	 * bits 7:5 = Erasable=0, State of Last Session=11b (complete),
+	 * bits 4:2 = Disc Status=11b (complete / finalized)
+	 * bit 1 = Dirty Bit (DBit) = 0
+	 * bit 0 = Data Type = 0 (Standard)
+	 */
+	buf[2] = (0x3 << 5) | /* State of Last Session = Complete */
+		  (0x3 << 2);  /* Disc Status = Complete */
+
+	buf[3] = 1; /* Number of First Track on Disc */
+
+	/*
+	 * byte 4: Number of Sessions (LSB)
+	 * byte 5: First Track Number in Last Session (LSB)
+	 * byte 6: Last Track Number in Last Session (LSB)
+	 */
+	buf[4] = 1; /* 1 session */
+	buf[5] = 1; /* first track in last session */
+	buf[6] = 1; /* last track in last session */
+
+	/*
+	 * byte 8: Disc Type
+	 * 0x00 = CD-DA or CD-ROM (used for both CD and DVD images;
+	 * actual device type is communicated via GET CONFIGURATION)
+	 */
+	buf[8] = 0x00;
+
+	/* bytes 9-31: Disc Identification, OPC tables, etc. -- all zeros */
+
+	return min_t(int, len, alloc_len);
+}
